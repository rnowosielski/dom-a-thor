{
  "manifest_version": 3,
  "name": "Dom-A-Thor",
  "short_name": "Dom-A-Thor",
  "description": "Preview house plot dimensions on your land parcel using supported Polish project catalog sites and optional GUGiK parcel ID lookup.",
  "version": "1.0.1",
  "permissions": [
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://www.extradom.pl/*",
    "https://www.archon.pl/*",
    "https://projektyzwizja.pl/*",
    "https://www.mgprojekt.com.pl/*",
    "https://wpcdn.pl/*",
    "https://i.wpimg.pl/*",
    "https://uldk.gugik.gov.pl/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.extradom.pl/*",
        "https://www.archon.pl/*",
        "https://projektyzwizja.pl/*",
        "https://www.mgprojekt.com.pl/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "Dom-A-Thor"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
