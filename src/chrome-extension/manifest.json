{
  "manifest_version": 3,
  "name": "Dom-A-Thor",
  "description": "This extension triggers on specific websites like extradom.pl, archon.pl, projektyzwizja.pl, and mgprojekt.com.pl.",
  "version": "1.0.1",
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": [
    "https://www.extradom.pl/*",
    "https://www.archon.pl/*",
    "https://projektyzwizja.pl/*",
    "https://www.mgprojekt.com.pl/*",
    "https://wpcdn.pl/*",
    "https://i.wpimg.pl/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.extradom.pl/*",
        "https://www.archon.pl/*",
        "https://projektyzwizja.pl/*",
        "https://www.mgprojekt.com.pl/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "index.html"
  },
  "icons": {
    "128": "icon.png"
  }
}